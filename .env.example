# ── API (apps/api) ───────────────────────────────────────────────────────────
# Conexão com o Postgres. Em produção use a "Internal Connection String" que o
# Coolify mostra na tela do banco resenha05-db.
DATABASE_URL=postgres://resenha05_app:senha@localhost:5432/resenha05
UPLOADS_DIR=uploads

# Segredos de autenticação (gere com: openssl rand -base64 48)
JWT_SECRET=troque-isto-em-producao
JWT_REFRESH_SECRET=troque-isto-tambem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DIAS=30

# Chave mestra p/ cifrar o Access Token de Mercado Pago das organizações.
# EXATAMENTE 32 bytes em base64 (openssl rand -base64 32).
RESENHA05_ENC_KEY=

# Porta HTTP da API
PORT=3000
# Origem permitida em dev (o nginx cuida disso em prod, mesma origem)
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development


# ── Mercado Pago (Fase 6+) ───────────────────────────────────────────────────
# O token do Mercado Pago da plataforma NÃO é env: o admin cola pelo painel
# (/admin) e fica cifrado em plataforma_config.
# Segredo do webhook de assinatura (painel do MP → Webhooks). Valida x-signature.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Admin de plataforma ──────────────────────────────────────────────────────
# OBRIGATÓRIA: telefone do "dev" (único que cadastra/remove admins de
# plataforma). Qualquer formato; a API normaliza para +55DDDXXXXXXXXX.
PLATAFORMA_DEV_TELEFONE=

# ── n8n (Fase 7) ─────────────────────────────────────────────────────────────
# Webhook do n8n que a API chama quando um pagamento é aprovado.
N8N_PAGAMENTO_WEBHOOK_URL=

# ── web (apps/web) ───────────────────────────────────────────────────────────
# Em dev NÃO precisa: o Vite faz proxy de /api para localhost:3000.
# Em produção (Coolify) é BUILD ARG, apontando para o domínio da API + /api:
#   VITE_API_URL=https://api-resenha05.coffetech.com.br/api
# VITE_API_URL=
